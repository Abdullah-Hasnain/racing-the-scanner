[2.89179, "o", "pid 8893: comm=victim cpus=0 ext.enabled : 1\r\npid 8894: comm=attacker cpus=0 ext.enabled : 1\r\n\r\n== phase baseline: attacker weight 100 (no override) ==\r\nmap: [] \r\n"]
