[12.967239, "o", "  window 3 (3s): victim  49.8%  attacker  50.1%\r\n\r\n== phase attack: attacker weight 2000 ==\r\nmap: [{ \"key\": 8894, \"value\": 2000 } ] \r\n"]
[16.997115, "o", "  window 1 (3s): victim   4.0%  attacker  96.0%\r\n"]
[20.017021, "o", "  window 2 (3s): victim   4.3%  attacker  95.7%\r\n"]
[23.038242, "o", "  window 3 (3s): victim   4.0%  attacker  96.0%\r\n\r\n== phase penalty: attacker weight 10 ==\r\nmap: [{ \"key\": 8894, \"value\": 10 } ] \r\n"]
