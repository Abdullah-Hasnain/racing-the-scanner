# Optional per-machine overrides. Nothing loads this file automatically: the
# scripts read these as ordinary environment variables. To use it, copy it to
# .env (gitignored), edit it, and export it into your shell first:
#   bash/zsh:    set -a; . ./.env; set +a
#   PowerShell:  $env:RTS_RESULTS_DIR = "D:\rts\results"   (one line per key)
# Every key has the default shown, so you only need the ones you change.

# Where result CSVs and figures go. Keep them OUTSIDE the repo on machines with
# small disks.
RTS_RESULTS_DIR=./results
RTS_FIGURES_DIR=./figures

# Local Ollama server for the Tracee AI-triage layer (detection/triage_llm.py).
RTS_LLM_URL=http://localhost:11434
RTS_LLM_MODEL=llama3.1:8b

# Simulation defaults (the CLI flags --seed and --runs override them).
RTS_SIM_SEED=42
RTS_SIM_RUNS=20
