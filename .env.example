# Copy to .env and adjust per machine. .env is gitignored.
# Nothing here is a secret; these are machine-local paths and toggles.

# Where large artifacts live (datasets, trained models, result CSVs).
# Keep this OUTSIDE the repo on machines with small disks.
RTS_DATA_DIR=./data
RTS_RESULTS_DIR=./results
RTS_FIGURES_DIR=./figures

# Local LLM endpoint for the Tracee AI-triage layer (Member 3).
# Point at an Ollama server (default) or a llama.cpp server.
RTS_LLM_BACKEND=ollama
RTS_LLM_URL=http://localhost:11434
RTS_LLM_MODEL=llama3.1:8b

# Set to 1 on a machine with an NVIDIA GPU to enable torch-based models.
RTS_USE_GPU=0

# Simulation defaults (override on the CLI too).
RTS_SIM_SEED=42
RTS_SIM_RUNS=20
