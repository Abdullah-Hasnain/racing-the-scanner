--- a/tools/sched_ext/scx_qmap.bpf.c
+++ b/tools/sched_ext/scx_qmap.bpf.c
@@ -18,6 +18,11 @@
  * This scheduler is primarily for demonstration and testing of sched_ext
  * features and unlikely to be useful for actual workloads.
  *
+ * Per-PID weight override (racing-the-scanner #11): userspace writes
+ * pid -> weight into the hash map pinned at /sys/fs/bpf/pid_weight. 100 is the
+ * nice-0 default, and a listed task's time slice is scaled by weight / 100.
+ * PIDs that are not in the map are scheduled exactly as before.
