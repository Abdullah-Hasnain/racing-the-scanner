@@ -29,6 +34,9 @@ enum consts {
 	SHARED_DSQ		= 0,
 	HIGHPRI_DSQ		= 1,
 	HIGHPRI_WEIGHT		= 8668,		/* this is what -20 maps to */
+	PIDW_DFL		= 100,		/* pid_weight value meaning 1x */
+	PIDW_MIN_SLICE_NS	= 200000,	/* 200us floor */
+	PIDW_MAX_SLICE_NS	= ONE_SEC_IN_NS, /* well under the 5s watchdog */
 };
 
 char _license[] SEC("license") = "GPL";
@@ -126,6 +134,17 @@ struct {
 	__type(value, struct cpu_ctx);
 } cpu_ctx_stor SEC(".maps");
 
+/* pid (tgid) -> weight, pinned by name so bpftool can edit it while we run */
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__uint(max_entries, 1024);
+	__type(key, pid_t);
+	__type(value, u32);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} pid_weight SEC(".maps");
+
+u64 nr_pidw_hits;
+
 /* Statistics */
 u64 nr_enqueued, nr_dispatched, nr_reenqueued, nr_dequeued, nr_ddsp_from_enq;
 u64 nr_core_sched_execed;
@@ -159,6 +178,31 @@ static struct task_ctx *lookup_task_ctx(struct task_struct *p)
 	return tctx;
 }
 
+/*
+ * Time slice for @p: slice_ns scaled by its pid_weight entry, or slice_ns
+ * unchanged if it has none. Keyed by tgid, the PID userspace sees, so every
+ * thread of a process shares its weight. Two always-runnable tasks taking
+ * turns on one CPU then split it in proportion to their weights.
+ */
+static u64 task_slice(struct task_struct *p)
+{
+	pid_t tgid = p->tgid;
+	u32 *w;
+	u64 slice;
+
+	w = bpf_map_lookup_elem(&pid_weight, &tgid);
+	if (!w)
+		return slice_ns;
+
+	__sync_fetch_and_add(&nr_pidw_hits, 1);
+	slice = slice_ns * *w / PIDW_DFL;
+	if (slice < PIDW_MIN_SLICE_NS)
+		return PIDW_MIN_SLICE_NS;
+	if (slice > PIDW_MAX_SLICE_NS)
+		return PIDW_MAX_SLICE_NS;
+	return slice;
+}
+
 s32 BPF_STRUCT_OPS(qmap_select_cpu, struct task_struct *p,
 		   s32 prev_cpu, u64 wake_flags)
 {
@@ -231,7 +275,7 @@ void BPF_STRUCT_OPS(qmap_enqueue, struct task_struct *p, u64 enq_flags)
 	 */
 	if (tctx->force_local) {
 		tctx->force_local = false;
-		scx_bpf_dsq_insert(p, SCX_DSQ_LOCAL, slice_ns, enq_flags);
+		scx_bpf_dsq_insert(p, SCX_DSQ_LOCAL, task_slice(p), enq_flags);
 		return;
 	}
 
@@ -239,7 +283,7 @@ void BPF_STRUCT_OPS(qmap_enqueue, struct task_struct *p, u64 enq_flags)
 	if (!__COMPAT_is_enq_cpu_selected(enq_flags) &&
 	    (cpu = pick_direct_dispatch_cpu(p, scx_bpf_task_cpu(p))) >= 0) {
 		__sync_fetch_and_add(&nr_ddsp_from_enq, 1);
-		scx_bpf_dsq_insert(p, SCX_DSQ_LOCAL_ON | cpu, slice_ns, enq_flags);
+		scx_bpf_dsq_insert(p, SCX_DSQ_LOCAL_ON | cpu, task_slice(p), enq_flags);
 		return;
 	}
 
@@ -267,7 +311,7 @@ void BPF_STRUCT_OPS(qmap_enqueue, struct task_struct *p, u64 enq_flags)
 
 	/* Queue on the selected FIFO. If the FIFO overflows, punt to global. */
 	if (bpf_map_push_elem(ring, &pid, 0)) {
-		scx_bpf_dsq_insert(p, SHARED_DSQ, slice_ns, enq_flags);
+		scx_bpf_dsq_insert(p, SHARED_DSQ, task_slice(p), enq_flags);
 		return;
 	}
 
@@ -432,7 +476,7 @@ void BPF_STRUCT_OPS(qmap_dispatch, s32 cpu, struct task_struct *prev)
 			update_core_sched_head_seq(p);
 			__sync_fetch_and_add(&nr_dispatched, 1);
 
-			scx_bpf_dsq_insert(p, SHARED_DSQ, slice_ns, 0);
+			scx_bpf_dsq_insert(p, SHARED_DSQ, task_slice(p), 0);
 			bpf_task_release(p);
 
 			batch--;
